+void SmfPlayerPage::applyFileTempoToGp(const SmfPlayerSnapshot& state) {
+    transportClockRuntime().setSource(TransportClockSource::GroovePuterInternal);
+    const float bpm = fileMasterBpm(state);
+    withAudioGuard([this, bpm]() { miniAcid_.setBpm(bpm); });
+}
+
+bool SmfPlayerPage::cycleTempoMode(const SmfPlayerSnapshot& state) {
+    if (!player_) return true;
+    const SmfTempoMode next = nextSmfTempoMode(state.tempoMode);
+    if (!player_->toggleTempoMode()) {
+        UI::showToast("MIDI PLAYER BUSY", 900);
+        return true;
+    }
+
+    if (next == SmfTempoMode::FileMaster) {
+        applyFileTempoToGp(state);
+        char toast[48];
+        std::snprintf(toast, sizeof(toast),
+                      "FILE MASTER %u.%u > GP > USB",
+                      static_cast<unsigned>(state.originalBpmX10 / 10),
+                      static_cast<unsigned>(state.originalBpmX10 % 10));
+        UI::showToast(toast, 1100);
+    } else if (next == SmfTempoMode::Project) {
+        const bool followSeqtrak = transportClockRuntime().source() ==
+            TransportClockSource::SeqtrakExternal;
+        UI::showToast(followSeqtrak
+                          ? "TEMPO: SEQ MASTER"
+                          : "TEMPO: GP MASTER > USB",
+                      1000);
+    } else {
+        UI::showToast("TEMPO: FILE ORIGINAL", 900);
+    }
+    return true;
+}
